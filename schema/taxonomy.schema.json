{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halvorAI/agent-fraud-taxonomy/blob/main/schema/taxonomy.schema.json",
  "title": "Agent payment fraud taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "license", "schema_reference", "single_mandate_check_values", "patterns"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "license": { "const": "Apache-2.0" },
    "schema_reference": { "type": "string", "format": "uri" },
    "single_mandate_check_values": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "minItems": 1
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "name", "description", "caught_by_single_mandate_check", "signals"],
        "properties": {
          "id": { "type": "string", "pattern": "^AFT-[0-9]{2}$" },
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "caught_by_single_mandate_check": { "enum": ["no", "rarely", "sometimes", "with_verified_credentials"] },
          "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
